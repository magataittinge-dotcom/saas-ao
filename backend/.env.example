# Copy this file to .env and fill in the values

# App
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/saas_ao

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — embeddings RAG (Phase 1). Laisser vide tant que le RAG n'est pas activé.
VOYAGE_API_KEY=

# AWS S3 (leave empty for local file storage in dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=eu-west-3

# Clerk (auth)
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# Billing provider — pluggable. Today only "stripe" is implemented.
BILLING_PROVIDER=stripe

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Maps Static API (for location maps in mémoire)
GOOGLE_MAPS_API_KEY=

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Locale config — France (defaults)
# Every value below can be swapped via env var without touching the codebase.
# ─────────────────────────────────────────────────────────────────────────────
COUNTRY_CODE=FR
CURRENCY=EUR
CURRENCY_SYMBOL=€
TAX_RATE=0.20
TAX_LABEL=TVA
TIMEZONE=Europe/Paris
LOCALE=fr_FR
DATE_FORMAT=%d/%m/%Y
COMPANY_NAME=Synorix
COMPANY_ADDRESS=
COMPANY_VAT_NUMBER=
COMPANY_REGISTRATION_NUMBER=
LEGAL_JURISDICTION=FR

# ─────────────────────────────────────────────────────────────────────────────
# Future UAE config (uncomment + comment-out the FR block above when migrating
# to the Dubai entity in 2027 — see backend/docs/MIGRATION_PROVIDER.md).
# ─────────────────────────────────────────────────────────────────────────────
# COUNTRY_CODE=AE
# CURRENCY=AED
# CURRENCY_SYMBOL=د.إ
# TAX_RATE=0.05
# TAX_LABEL=VAT
# TIMEZONE=Asia/Dubai
# LOCALE=ar_AE
# DATE_FORMAT=%Y-%m-%d
# COMPANY_NAME=Synorix LLC
# COMPANY_ADDRESS=
# COMPANY_VAT_NUMBER=
# COMPANY_REGISTRATION_NUMBER=
# LEGAL_JURISDICTION=AE
