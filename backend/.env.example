# Copy this file to .env and fill in the values

# App
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/saas_ao

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# Jeu de démonstration de l'analyse DCE quand la clé est absente ou refusée.
# 0 par défaut : l'analyse échoue proprement (unité rendue). Refusé au démarrage hors DEBUG.
SYNORIX_ANALYSE_DEMO=0

# Voyage AI — embeddings RAG (Phase 1). Laisser vide tant que le RAG n'est pas activé.
VOYAGE_API_KEY=

# AWS S3 (leave empty for local file storage in dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=eu-west-3

# Clerk (auth)
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# Billing provider — pluggable. Today only "stripe" is implemented.
BILLING_PROVIDER=stripe

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Produit Stripe de l'offre Essentiel (149 €/mois) — vide tant qu'il n'est pas créé
STRIPE_PRODUCT_ESSENTIEL=

# Frontend URL (CORS) — en production : https://synorix.tech (refus de démarrer si « localhost » hors DEBUG)
FRONTEND_URL=http://localhost:3000

# Jeton d'accès à /api/metrics (agrégats de la plateforme). Vide en production = route fermée (404).
METRICS_TOKEN=

# E-mails de l'appli (notifications). Vide = notifications dans l'appli seulement, jamais d'erreur.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Modèle forcé pour la rédaction du mémoire et la réécriture d'un passage (vide = Sonnet 5.5, réglage du code)
MEMOIRE_MODELE=
# Enrichissement de l'analyse par le corpus réglementaire (RAG) : coupé tant que VOYAGE_API_KEY est vide
RAG_ENRICHMENT=false
# Taux indicatif dollar -> euro pour le journal des coûts d'IA (table couts_ia)
COUT_USD_EUR=0.92

# Lecture des dépôts de « Mon entreprise » (Haiku), par entreprise
DEPOT_APPELS_PAR_JOUR=60
DEPOT_BUDGET_MENSUEL_EUR=3
DEPOT_LECTURES_EN_ATTENTE=10

# Purge des AO supprimés (tâche quotidienne du worker) : 0 = simulation (comptes au journal, rien supprimé)
SYNORIX_PURGE_AO_ACTIVE=0
SYNORIX_PURGE_AO_JOURS=30

# ─────────────────────────────────────────────────────────────────────────────
# Serveur de production (valeurs du VPS ; vides ou absentes en développement). Détail : docs/DEPLOYMENT.md § 6.
# ─────────────────────────────────────────────────────────────────────────────
# Document entier de « Voir dans le DCE » servi par nginx (X-Accel-Redirect) : /_fichiers_internes en production
SYNORIX_X_ACCEL_PREFIX=
# Caches d'aperçu (hors webroot ; défaut : backend/cache/apercus et backend/cache/fiches) et leurs plafonds en Mo
# SYNORIX_CACHE_APERCUS_DIR=/srv/synorix/backend/cache/apercus
# SYNORIX_CACHE_APERCUS_MO=2048
# SYNORIX_CACHE_FICHES_DIR=/srv/synorix/backend/cache/fiches
# SYNORIX_CACHE_FICHES_MO=256
# Lecture des PDF en processus isolés (2 enfants sur le KVM 2 : posé dans deploy/systemd/synorix-api.service)
# SYNORIX_EXTRACTION_PROCESSUS=1
# SYNORIX_PDFIUM_PROCESSUS=1
# SYNORIX_PDFIUM_AS_MO=1536
# SYNORIX_PDFIUM_TACHES_MAX=40
# SYNORIX_PDFIUM_RSS_MAX_MO=350
# SYNORIX_PDFIUM_ATTENTE_S=5
# SYNORIX_PDFIUM_ATTENTE_EXTRACTION_S=600
# SYNORIX_PDFIUM_LANDLOCK=auto
# SYNORIX_PDFIUM_LECTURE_DIRS=
# LibreOffice isolé (conversion des Word, export PDF) ; « exige » en production une fois l'isolation vérifiée (VPS.md C6)
# SYNORIX_LIBREOFFICE_DIR=/srv/synorix/backend/cache/libreoffice
# SYNORIX_LIBREOFFICE_AS_MO=1536
# SYNORIX_LIBREOFFICE_FICHIER_MO=512
# SYNORIX_LIBREOFFICE_DELAI_S=120
# SYNORIX_LIBREOFFICE_ATTENTE_S=90
# SYNORIX_LIBREOFFICE_ATTENTE_DEPOT_S=900
# SYNORIX_LIBREOFFICE_RESEAU=auto
# SYNORIX_LIBREOFFICE_LANDLOCK=auto
# SYNORIX_LIBREOFFICE_TMP=auto
# 1 = l'API reste « vidable » (diagnostic py-spy seulement ; jamais en production)
# SYNORIX_DUMPABLE=

# ─────────────────────────────────────────────────────────────────────────────
# Locale config — France (defaults)
# Every value below can be swapped via env var without touching the codebase.
# ─────────────────────────────────────────────────────────────────────────────
COUNTRY_CODE=FR
CURRENCY=EUR
CURRENCY_SYMBOL=€
TAX_RATE=0.20
TAX_LABEL=TVA
TIMEZONE=Europe/Paris
LOCALE=fr_FR
DATE_FORMAT=%d/%m/%Y
COMPANY_NAME=Synorix
COMPANY_ADDRESS=
COMPANY_VAT_NUMBER=
COMPANY_REGISTRATION_NUMBER=
LEGAL_JURISDICTION=FR

# ─────────────────────────────────────────────────────────────────────────────
# Future UAE config (uncomment + comment-out the FR block above when migrating
# to the Dubai entity in 2027 — see backend/docs/MIGRATION_PROVIDER.md).
# ─────────────────────────────────────────────────────────────────────────────
# COUNTRY_CODE=AE
# CURRENCY=AED
# CURRENCY_SYMBOL=د.إ
# TAX_RATE=0.05
# TAX_LABEL=VAT
# TIMEZONE=Asia/Dubai
# LOCALE=ar_AE
# DATE_FORMAT=%Y-%m-%d
# COMPANY_NAME=Synorix LLC
# COMPANY_ADDRESS=
# COMPANY_VAT_NUMBER=
# COMPANY_REGISTRATION_NUMBER=
# LEGAL_JURISDICTION=AE

# ─────────────────────────────────────────────────────────────────────────────
# Plafonds de sécurité (audit de sécurité S-01 à S-06, 11/11/2026). Valeurs par défaut ci-dessous ; 0 = coupé.
# ─────────────────────────────────────────────────────────────────────────────
# Appels d'IA sans unité, par organisation et par 24 h glissantes
IMPORT_MEMOIRE_MAX_PAR_JOUR=5
REFORMULER_MAX_PAR_JOUR=30
# Filet général : dépense d'IA en euros par organisation et par 24 h (couts_ia + réservations en cours)
BUDGET_IA_JOUR_EUR=60
BUDGET_IA_FORFAIT_ANALYSE_EUR=3
BUDGET_IA_FORFAIT_MEMOIRE_EUR=1.5
BUDGET_IA_FORFAIT_REFAIRE_EUR=0.5
BUDGET_IA_FORFAIT_APPEL_EUR=0.2
BUDGET_IA_RESERVATION_MINUTES=120
# Lancements par organisation et par jour, toutes offres
PLAFOND_JOUR_ANALYSES=20
PLAFOND_JOUR_MEMOIRES=20
# AO offert réservé à un SIRET vérifié (condition de l'offre, décision du fondateur) : 0 = éteinte
ESSAI_EXIGE_SIRET=0
# Stockage par organisation (Go) et garde du disque des dépôts
QUOTA_STOCKAGE_GO=20
QUOTA_STOCKAGE_GRATUIT_GO=5
DISQUE_LIBRE_MIN_POURCENT=15

# ─────────────────────────────────────────────────────────────────────────────
# Fonctions à appel d'IA livrées ÉTEINTES (mission finale, C1 à C4 ; services/fonctions_ia.py). 1 = allumée.
# Éteinte : la route répond 404, aucun bouton, aucun coût. Allumer seulement après un passage réel vérifié.
# ─────────────────────────────────────────────────────────────────────────────
# C1 « Proposer un paragraphe » (relecture, Sonnet 5.5, plafond partagé avec la réécriture)
RELECTURE_PROPOSER=0
# C2 « Réécrire » en trois propositions avec « Voir les différences » (Sonnet 5.5, plafond partagé)
REECRIRE_TROIS=0
# C3 « Ce que vous voulez dire » proposé pour chaque fiche du plan (Haiku 4.5, 20 par jour)
FICHE_PROPOSEE=0
# C4 « Le style de mon entreprise » lu dans un ancien mémoire (Haiku 4.5, 5 par jour) : lecture seule,
# jamais envoyé au générateur (décision D5). Table styles_entreprise (migration 0036).
STYLE_ENTREPRISE=0
