# Copier ce fichier en .env (dev) ou .env.production (build prod).
# ⚠️ Vite fige import.meta.env AU BUILD : ces variables doivent être posées
# AVANT `npm run build` (les changer ensuite est sans effet).

# Clerk (auth) — REQUISE : le front lève une erreur au démarrage sans elle
# (src/main.tsx). pk_test_... en dev, pk_live_... en prod.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# URL de l'API. Dev : http://localhost:8000. Prod : laisser VIDE
# (= même origine, nginx proxifie /api/ vers le backend).
VITE_API_URL=http://localhost:8000

# Google Maps Static (optionnelle — la carte est simplement omise si vide).
VITE_GOOGLE_MAPS_API_KEY=
