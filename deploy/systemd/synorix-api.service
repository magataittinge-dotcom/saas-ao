# Synorix — API FastAPI. Source de vérité : deploy/systemd/synorix-api.service du dépôt.
# Installé en /etc/systemd/system/synorix-api.service (procédure : VPS.md).
[Unit]
Description=Synorix API (FastAPI)
After=network.target postgresql.service redis-server.service
Requires=postgresql.service

[Service]
Type=simple
User=synorix
Group=synorix
WorkingDirectory=/srv/synorix/backend
# Secrets : /etc/synorix/synorix.env (root, 0600), lu par systemd en root ; synorix ne peut pas le lire,
# l'appli reçoit les variables par son environnement (aucun backend/.env en production).
EnvironmentFile=/etc/synorix/synorix.env
# --workers 1 OBLIGATOIRE : progression en mémoire du processus, travaux longs en threads de l'API,
# réconciliation au démarrage mono-processus (DEPLOYMENT.md §7). Vrai aussi sur le KVM 2 (2 vCPU) : un
# second processus API casserait la progression ; les 2 cœurs servent Postgres, PDFium et LibreOffice.
# --forwarded-allow-ips 127.0.0.1, JAMAIS « * » : sinon l'IP client se falsifie par X-Forwarded-For.
# --timeout-graceful-shutdown 20 : un flux SSE ouvert empêche sinon l'arrêt propre jusqu'au SIGKILL
# (mesuré au bloc 6 : jamais arrêté en 20 s sans l'option, 5,2 s avec 5).
ExecStart=/srv/synorix/backend/venv/bin/uvicorn main:app \
  --host 127.0.0.1 --port 8000 \
  --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 \
  --timeout-graceful-shutdown 20 \
  --access-log --log-config /srv/synorix/backend/log_config.json
# KVM 2 : deux processus PDFium (au lieu d'un). Sur 2 cœurs, un second processus travaille vraiment en
# parallèle : le clic « Voir dans le DCE » d'une organisation n'attend plus l'extraction d'un gros dépôt d'une
# autre (sur le KVM 1, un seul cœur : 1). Seul le pool de l'API en a besoin, le worker Celery ne lit aucun PDF.
# Chacun est plafonné par le code (RLIMIT_AS 1,5 Go virtuels, recyclé au-delà de 350 Mo résidents, pic mesuré
# 603 Mo, BILAN-bloc-6). LibreOffice reste UNE conversion à la fois (verrou de fichier dans le code, pas de
# réglage) : pic mesuré 992 Mo.
Environment=SYNORIX_PDFIUM_PROCESSUS=2
Restart=always
RestartSec=5
# B6 : uvicorn ne gère que SIGINT et SIGTERM ; SIGQUIT le tue sans arrêt propre (mesuré au bloc 6).
# Les travaux en threads coupés par l'arrêt sont repris par la réconciliation au démarrage suivant.
KillSignal=SIGTERM
# SIGTERM au seul processus principal ; ses enfants (PDFium, LibreOffice) reçoivent SIGKILL
# à la fin du délai s'ils restent.
KillMode=mixed
TimeoutStopSec=30

# Budget du KVM 2 (2 vCPU, 8 Go = 8192 Mo) — somme des plafonds, vérifiée par tests/test_deploy_kvm2.py :
#   système + nginx + sshd + fail2ban .... 700   (Ubuntu 24.04 au repos ~400, marge de pic ; à relever avec `free -m`)
#   Postgres ............................ 1900   (shared_buffers 1024 + ~45 connexions x 6 + 12 tris x 2 x 16 + autovacuum 3 x 64)
#   Redis ................................ 300   (maxmemory 256 + tampons clients)
#   API (ce groupe) ..................... 3200   (MemoryMax)
#   worker Celery ........................ 800
#   beat ................................. 200
#   ------------------------------------------------
#   total des plafonds ................. 7100 Mo, soit 1092 Mo (13 %) de marge : cache de pages du noyau,
#   sauvegarde de nuit (<= 1 Go, minuteur à 03 h, quand l'API est calme) et fichier d'échange de 2 Go en dernier recours.
# Ce groupe compte l'API (~150 Mo au repos, jusqu'à ~400 Mo avec des mémoires en cours : estimation, à relever
# avec `systemctl show synorix-api -p MemoryPeak`), au plus 2 enfants PDFium
# (603 Mo au pic mesuré chacun, recyclés au-delà de 350 Mo) et UNE conversion LibreOffice (992 Mo au pic mesuré) :
# pire cas simultané 400 + 2 x 603 + 992 = 2598 Mo. MemoryHigh 2800 = juste au-dessus du pire cas : en dessous,
# aucun ralentissement ; au-delà, le noyau ralentit et récupère. MemoryMax 3200 = pire cas + 23 % : à ce seuil,
# le noyau tue le plus gros processus du groupe (en pratique un enfant), et OOMPolicy=continue garde l'API debout.
MemoryHigh=2800M
MemoryMax=3200M
OOMPolicy=continue
# CPU : 2 vCPU = 200 %. L'API et ses enfants ne dépassent pas 150 % : il reste au moins un demi-cœur pour Postgres,
# nginx et Redis, même pendant deux lectures de PDF et une conversion Word.
CPUQuota=150%
# Processus + fils d'exécution du groupe (compte les deux). Estimation : API ~60 fils, 2 enfants PDFium, soffice ~40 ;
# 512 couvre trois fois ce régime (à relever avec `systemctl show synorix-api -p TasksCurrent`) et arrête une boucle
# de création de fils bien avant l'épuisement du système.
TasksMax=512

# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# cache/ : aperçus de « Voir dans le DCE » et LibreOffice (verrou partagé avec le worker, profils
# jetables). Obligatoire : sans lui, le service refuse de démarrer (VPS.md, étape 2.3).
# Le « - » tolère un dossier absent.
ReadWritePaths=/srv/synorix/backend/uploads /srv/synorix/backend/cache -/var/log/synorix
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
